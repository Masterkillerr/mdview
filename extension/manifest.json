{
  "manifest_version": 2,
  "name": "mdview",
  "version": "2.0.4",
  "description": "Sends local .md, .html, .pdf and picture files to your mdview reader, and defines words from any page",
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "browser_specific_settings": {
    "gecko": {
      "id": "mdview@example.com",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["technicalAndInteraction"]
      }
    }
  },
  "permissions": [
    "file:///*",
    "tabs",
    "storage",
    "menus",
    "activeTab",
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*",
    "https://en.wiktionary.org/*"
  ],
  "background": {
    "scripts": ["dictionaries.js", "refresh.js"]
  },
  "browser_action": {
    "default_title": "Open mdview",
    "default_icon": { "48": "icon.svg", "96": "icon.svg" }
  }
}
