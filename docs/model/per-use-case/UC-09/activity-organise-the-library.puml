@startuml
' UC-09 - Organise the library.  The goal, whole.
' Activity - the change, the checks, the change on the disk.
' Sources: ../../../analysis/use-case-descriptions.md (UC-09)

skinparam shadowing false
skinparam {
  BackgroundColor White
  BorderColor #333
  ArrowColor #333
}

start
:the reader picks a change in the library;

partition "the reader" {
  :the origin is checked;
  :the token is checked (S-1);
  if (the change is inside one of the roots?) then (yes)
    :the change is made on the disk (D5);
    if (the kind is one the library keeps?) then (yes)
      :the change is made;
    else (no)
      :refused, and the kinds the library keeps are named (F-23);
    endif
  else (no)
    :refused, and the reason is named;
  endif
}

:the page reloads, and the listing is what is on the disk;

stop
@enduml
